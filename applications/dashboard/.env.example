# EchoMap - variáveis de ambiente do servidor/painel.
# Copie para applications/dashboard/.env e preencha. O .env fica FORA do git (.gitignore).
# Tudo é opcional: sem .env o painel funciona como antes (senha gerada em data/auth.json, broker aberto).

# ---------- Login do painel ----------
# Usuário e senha para abrir o painel em outro aparelho. Sem DASHBOARD_USER, só a senha é pedida.
DASHBOARD_USER=
DASHBOARD_PASS=
# Segredo que assina o cookie de sessão (texto aleatório longo). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 0 = pede login também no próprio computador (localhost). Padrão: 1 (abre direto no PC).
DASHBOARD_TRUST_LOCALHOST=1

# ---------- Broker MQTT embutido ----------
# Com os dois preenchidos, o broker só aceita clientes com este usuário e senha.
# A placa precisa dos mesmos valores em esp32-esp8266/no-principal/include/secrets.h (MQTT_USER/MQTT_PASS).
MQTT_USER=
MQTT_PASS=

# ---------- Alertas críticos por e-mail ----------
# 1 = liga. Dispara para queda confirmada, pedido de ajuda (botão SOS) e saída de zona segura.
EMAIL_ENABLED=0
# smtp (Gmail com senha de app, Brevo, Resend...), ses (SMTP do Amazon SES) ou mock (só registra, não envia)
EMAIL_PROVIDER=smtp
# Gmail: smtp.gmail.com, 465 e uma "senha de app" (myaccount.google.com/apppasswords) em SMTP_PASS.
# Brevo: smtp-relay.brevo.com, 587. SES: deixe SMTP_HOST vazio e defina AWS_REGION (ex.: us-east-1).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
AWS_REGION=
# Remetente (no Gmail, o próprio endereço) e destinatários separados por vírgula
EMAIL_FROM=
ALERT_EMAIL_TO=
# No máximo 1 e-mail por dispositivo e tipo de alerta a cada N segundos
EMAIL_COOLDOWN_S=180
# Endereço do painel para o botão "Abrir o painel" no e-mail (opcional), ex.: http://192.168.0.10:3000
PANEL_URL=

# ---------- Banco de dados ----------
# Dias de telemetria bruta guardada (ocorrências e áreas críticas nunca são apagadas)
RETENTION_DAYS=30
